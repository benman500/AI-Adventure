          "type": "grant_item",
          "item_code": "fresh_spirit_herb",
          "display_name": "Fresh Spirit Herb",
          "quantity": 1
        },
        { "type": "adjust_relationship", "npc_id": "npc_herb_steward_001", "delta": 3 }
      ],
      "supports_facets": ["institutional_favor"],
      "trigger_kind": "after_duty",
      "presentation": {
        "placeholder_summary": "You spend the day among damp leaves and careful hands. The herb steward nods once—work done properly."
      }
    },
